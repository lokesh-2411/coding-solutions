#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int N;
	cin >> N;
	
	vector<int> Arr(N);
	for(int i = 0 ; i < N ; i++) cin >> Arr[i];
	
	int Min = *min_element(Arr.begin(), Arr.end());
	int Cost = 0;
	
	for(int i = 0 ; i < N ; i++) Cost += (Arr[i] - Min);
	
	cout << Cost << endl;

}
