#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int Test;
	cin >> Test;
	
	while(Test--){
	    string S;
	    cin >> S;
	    int Val = 0;
	    for(int i = 0 ; i < (int)S.size() ; i++){
	        Val += (S[i] - '0');
	    }
	    
	    cout << (Val % 10 == 0 ? "Valid" : "Invalid") << endl;
	}

}